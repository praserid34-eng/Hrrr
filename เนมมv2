-- ระบบคลิกยิงอากาศ ดึงฆาตกรมาล็อกหัว 100% ทันทีเมื่อคลิกซ้าย
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton1 then
        local murderer, _ = GetMM2Roles()
        
        if Config.ShootAirToMurder and murderer and murderer.Character then
            local mHrp = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("Head")
            local mHead = murderer.Character:FindFirstChild("Head")
            if mHrp and mHead then
                local screenPos, onScreen = Camera:WorldToViewportPoint(mHrp.Position)
                if onScreen then
                    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    
                    if distToCenter <= Config.AimFOVRadius then
                        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myHrp then
                            -- ดึงฆาตกรมาใกล้หน้าทันทีเพื่อให้รู้ตัวว่าโดนดึงกลางอากาศ
                            mHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3.5)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, mHead.Position)
                            myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(mHead.Position.X, myHrp.Position.Y, mHead.Position.Z))
                            
                            local gunTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                            if not gunTool and LocalPlayer:FindFirstChildOfClass("Backpack") then
                                for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                                    if item:IsA("Tool") and (string.lower(item.Name):find("gun") or string.lower(item.Name):find("revolver")) then
                                        LocalPlayer.Character.Humanoid:EquipTool(item)
                                        gunTool = item
                                        break
                                    end
                                end
                            end
                            
                            pcall(function()
                                if gunTool then
                                    gunTool:Activate()
                                end
                            end)
                        end
                    end
                end
            end
        end

        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetPos = p.Character.HumanoidRootPart.Position
                    if (myPos - targetPos).Magnitude <= Config.AttackRadius then
                        pcall(function()
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if hum then
                                hum.Health = 0
                            end
                        end)
                    end
                end
            end
        end
    end
end)

