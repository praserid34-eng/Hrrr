        end
    end
    return OldNameCall(self, ...)
end)

-- ระบบดีดผู้เล่นขั้นเด็ดขาด 100% (ทะลุกำแพง ล็อกเป้าหมายกระเด็นหลุดห้องชัวร์ และกลับจุดเดิม 100%)
local function FlingAndKickPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Head")
    local myChar = LocalPlayer.Character
    if not targetHrp or not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHumanoid then return end

    -- บันทึกตำแหน่งเดิมแบบละเอียด 100%
    local originalCFrame = myHrp.CFrame

    -- ปิดการชนทุกชิ้นส่วนเพื่อให้พุ่งทะลุสิ่งกีดขวางได้ 100%
    myHumanoid.PlatformStand = true
    for _, part in pairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local startTime = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local tHrp = targetPlayer.Character.HumanoidRootPart
            -- สร้างแรงเหวี่ยงและความเร็วมหาศาล ทะลุกำแพงและแมพ 100%
            local randomOffset = CFrame.Angles(math.random(-500, 500), math.random(-500, 500), math.random(-500, 500))
            myHrp.CFrame = tHrp.CFrame * randomOffset
            myHrp.Velocity = Vector3.new(999999, 999999, 999999)
            myHrp.RotVelocity = Vector3.new(999999, 999999, 999999)
        end
        
        -- ใช้เวลาพุ่งกระแทก 0.45 วินาที เพื่อให้มั่นใจว่าเป้าหมายกระเด็นหลุดแมพแน่ๆ
        if tick() - startTime > 0.45 then
            if connection then
                connection:Disconnect()
            end
            
            -- คืนค่าสถานะตัวละคร กลับสู่ตำแหน่งเดิม 100%
            myHumanoid.PlatformStand = false
            myHrp.Velocity = Vector3.new(0, 0, 0)
            myHrp.RotVelocity = Vector3.new(0, 0, 0)
            myHrp.CFrame = originalCFrame

            -- สั่งเตะผู้เล่นออกจากเซิร์ฟเวอร์ทันที
            pcall(function()
                if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
                    targetPlayer.Character.Humanoid.Health = 0
                end
                targetPlayer:Kick("คุณถูกดีดกระเด็นทะลุออกนอกห้องโดยระบบของ DRAGON_12_6")
            end)

            Fluent:Notify({
                Title = "ดีดผู้เล่นสำเร็จ 100%",
                Content = "พุ่งกระแทกดีด " .. targetPlayer.Name .. " หลุดออกนอกห้อง และกลับจุดเดิมเรียบร้อย!",
                Duration = 3
            })
        end
    end)
end

-- ฟังก์ชันดีดผู้เล่นตามบทบาท
local function KickSpecificRole(roleType)
    local murderer, sheriff = GetMM2Roles()
    local found = false
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local match = false
            if roleType == "Murderer" and p == murderer then match = true end
            if roleType == "Sheriff" and p == sheriff then match = true end
            if roleType == "Innocent" and p ~= murderer and p ~= sheriff then match = true end
            
            if match then
                found = true
                FlingAndKickPlayer(p)
            end
        end
    end
    
    if not found then
        Fluent:Notify({
            Title = "ไม่พบเป้าหมาย",
            Content = "ไม่พบผู้เล่นในบทบาทนี้ขณะนี้",
            Duration = 2
        })
    end
end

-- ฟังก์ชันดีดผู้เล่นตามชื่อ
local function KickPlayerByName(targetName)
    if targetName == "" then
        Fluent:Notify({
            Title = "กรุณากรอกชื่อ",
            Content = "โปรดพิมพ์ชื่อผู้เล่นที่ต้องการดีดออกก่อนกด",
            Duration = 2
        })
        return
    end
    
    local found = false
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), string.lower(targetName)) or string.find(string.lower(p.DisplayName), string.lower(targetName)) then
                found = true
                FlingAndKickPlayer(p)
            end
        end
    end
    
    if not found then
        Fluent:Notify({
            Title = "ไม่พบชื่อผู้เล่น",
            Content = "ไม่พบผู้เล่นที่ตรงกับชื่อที่คุณกรอก",
            Duration = 2
        })
    end
end

