-- ฟังก์ชันค้นหาบทบาท MM2 (รองรับทุกเคส Item/Backpack/Character)
local function GetMM2Roles()
    local murderer, sheriff
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local bp = p:FindFirstChildOfClass("Backpack")
            local function checkItem(item)
                if item and item:IsA("Tool") then
                    local name = string.lower(item.Name)
                    if name:find("knife") or name:find("blade") or name:find("dagger") then
                        murderer = p
                    elseif name:find("gun") or name:find("revolver") or name:find("sheriff") then
                        sheriff = p
                    end
                end
            end

            for _, item in pairs(p.Character:GetChildren()) do
                checkItem(item)
            end
            if bp then
                for _, item in pairs(bp:GetChildren()) do
                    checkItem(item)
                end
            end
        end
    end
    return murderer, sheriff
end

-- ฟังก์ชันดึงหัวฆาตกรมาไว้ตรงหน้าปืน ล็อกหัว 100% บังคับกล้อง แจ้งเตือนและยิงทันที
local function PullMurdererToAimAndShoot()
    local murderer, _ = GetMM2Roles()
    if murderer and murderer.Character and LocalPlayer.Character then
        local mHrp = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("Head")
        local mHead = murderer.Character:FindFirstChild("Head")
        local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if mHrp and mHead and myHrp then
            -- ดึงหัว/ตัวฆาตกรมาไว้ตรงหน้าตัวเราพอดีเป๊ะ (ระยะประชิด 3.5 หน่วย) ทำให้ฆาตกรู้ตัวทันทีว่าโดนดึงกลางอากาศ
            mHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3.5)
            
            -- บังคับล็อกกล้องและหันตัวละครล็อกหัว 100%
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, mHead.Position)
            myHrp.CFrame = CFrame.new(myHrp.Position, Vector3.new(mHead.Position.X, myHrp.Position.Y, mHead.Position.Z))
            
            -- สั่งหยิบปืนและยิงอัตโนมัติ 100% ทันที
            local gunTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if not gunTool and LocalPlayer:FindFirstChildOfClass("Backpack") then
                for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                    if item:IsA("Tool") and (string.lower(item.Name):find("gun") or string.lower(item.Name):find("revolver")) then
                        LocalPlayer.Character.Humanoid:EquipTool(item)
                        gunTool = item
                        break
                    end
                end
            end
            
            pcall(function()
                if gunTool then
                    gunTool:Activate()
                end
            end)
            
            Fluent:Notify({
                Title = "ดึงฆาตกรกลางอากาศ & ล็อกหัว 100%!",
                Content = "ดึงตัว " .. murderer.Name .. " มาตรงหน้าและลั่นไกยิงหัวสำเร็จ!",
                Duration = 2.5
            })
        end
    else
        Fluent:Notify({
            Title = "ไม่พบฆาตกร",
            Content = "ยังไม่พบตัวฆาตกรในรอบนี้หรือตัวละครไม่พร้อม",
            Duration = 2
        })
    end
end

